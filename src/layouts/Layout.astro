	#menu {
		width: 40px;
		height: 40px;
		display: flex;
		justify-content: center;
		align-items: center;
		background-color: #151515;
		border-radius: 50%;
		color: white;
		border: none;
		cursor: pointer;
		transition: background-color 300ms;

		&:hover {
			background-color: #9850d3;
		}
	}
</style>

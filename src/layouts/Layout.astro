---
import "@/styles/global.css";
import "@fontsource-variable/onest/wght.css";
---

<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Alexander Sandoval - Desarrollador Full-stack</title>
		<link rel="icon" href="img/xd.jpg" type="image/jpg" />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--primaryBGColor: #0b1326;
		--primaryColor: #9850d3;
	}

	* {
		box-sizing: border-box;
	}

	img {
		max-width: 100%;
	}

	body {
		min-height: 100vh;
		font-family: "Onest Variable", system-ui, sans-serif;
		background-color: var(--primaryBGColor);
		color: white;
	}

	@keyframes openModalAnimation {
		from {
			transform: scale(0);
			opacity: 0;
		}
		to {
			transform: scale(1);
			opacity: 1;
		}
	}

	@keyframes openModalBackgroundAnimation {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}
</style>

---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Hero from "@/components/Hero.astro";
import ExperienceSection from "@/components/sections/ExperienceSection.astro";
import Footer from "@/components/Footer.astro";
import StackSection from "@/components/sections/StackSection.astro";

import { ProjectsSection } from "@/components/sections/ProjectsSection";
import CTASection from "@/components/sections/CTASection.astro";
import Divider from "@/components/Divider.astro";
---

<Layout>
	<Header />
	<main class="max-w-5xl mx-auto mt-15 px-7 flex flex-col gap-32">
		<Hero />
		<StackSection />
		<ExperienceSection />
		<section>
			<h2 class="flex mb-12 items-center gap-x-4 text-3xl font-semibold">
				<Divider />
				Proyectos Destacados
			</h2>

			<ProjectsSection client:visible />
		</section>
	</main>
	<Footer />
</Layout>

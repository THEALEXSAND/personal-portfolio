---
import Layout from "../layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import ExperienceSection from "@/components/sections/ExperienceSection.astro";

import { ProjectsSection } from "@/components/sections/ProjectsSection";
---

<Layout>
	<main class="max-w-5xl mx-auto mt-15 px-7">
		<Hero />

		<ExperienceSection />

		<!-- Seccion de mis habilidades de programacion -->
		<section class="my-10">
			<h3 class="text-xl text-center font-semibold">Mis Proyectos</h3>
			<p class="text-[15px] text-center my-2">
				Estas son algunas de las tecnologías y lenguajes de programación dentro
				del entorno de desarrollo web, de las cuales tengo conocimientos
				actualmente.
			</p>

			<ProjectsSection client:visible />
		</section>
	</main>
</Layout>

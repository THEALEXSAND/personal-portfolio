---
import { experiences } from "@/data/experiences-data";
import { TechnologyBadgeItem } from "../TechnologyBadgeItem";
---

<section id="experience">
	<h3 class="mb-16 text-4xl text-[#dae2fd] text-center font-semibold">
		Experiencia Laboral
	</h3>

	<ul
		class="relative flex flex-col gap-24 before:-z-2 before:absolute before:left-1/2 before:inset-y-0 before:-translate-x-1/2 before:w-0.5 before:bg-white/20"
	>
		{
			experiences.map((experience) => (
				<li class="relative">
					<article class="grid grid-cols-2 justify-center items-center gap-30">
						<div class="flex flex-col gap-1 items-end text-right">
							<h4 class="text-2xl text-[#d0bcff] font-semibold">
								{experience.title}
							</h4>
							<h5 class="text-lg text-[#dae2fd] font-semibold">
								{experience.company}
							</h5>
							<span class="bg-[#131b2e] block px-3 py-1 text-xs font-medium outline-2 outline-white/5 rounded-full">
								{experience.date}
							</span>
						</div>
						<div class="bg-[#241B45]/50 flex flex-col gap-y-6 p-6 rounded-xl">
							<p>{experience.description}</p>

							{experience.stack.length > 0 && (
								<ul class="flex flex-wrap gap-3">
									{experience.stack.map((tech) => (
										<TechnologyBadgeItem rounded="xs" technology={tech}>
											{tech.name}
										</TechnologyBadgeItem>
									))}
								</ul>
							)}
						</div>
					</article>
					<div class="-z-1 absolute top-0 left-1/2 -translate-x-1/2 size-4 bg-[#d0bcff] rounded-full" />
				</li>
			))
		}
	</ul>
</section>

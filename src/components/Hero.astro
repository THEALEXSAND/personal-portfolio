---
import AvailableButton from "./AvailableButton.astro";
import EmailIcon from "./icons/EmailIcon.astro";
import GitHubIcon from "./icons/GitHubIcon.astro";
import LinkedInIcon from "./icons/LinkedInIcon.astro";
---

<section
	class="max-h-[700px] h-[90vh] flex items-center border-b-3 border-[#9850d3]"
>
	<article class="w-full flex justify-between items-center">
		<div class="font-semibold">
			<div class="flex items-center gap-4 mb-6">
				<h2 class="font-medium">¡Hola, bienvenido!</h2>
				<AvailableButton>Disponible para trabajar</AvailableButton>
			</div>

			<h3 class="text-5xl">Soy Alexander</h3>
			<h4 class="text-4xl my-6 text-white/90">
				Desarrollador Full-stack de Sistemas Informáticos
			</h4>

			<article class="font-normal text-white/80 mb-4">
				<p class="mb-1">
					Llevo +5 años programando, tengo experiencia en aplicaciones de
					software, desarrollo web, algoritmos, técnicas de desarrollo y
					estructura de datos.
				</p>
				<p>
					Estoy motivado a trabajar y colaborar en ambientes de trabajo en donde
					se presenten futuros proyectos. También estoy abierto a nuevas
					oportunidades y desafíos que me permitan crecer profesionalmente y
					contribuir con mis habilidades.
				</p>
			</article>

			<div class="flex items-start gap-4">
				<a
					class="flex items-center gap-x-2 border-2 border-purple-700 rounded-full py-2 px-4 font-medium text-sm hover:bg-purple-700 transition-colors duration-300"
					href="mailto:sandovaltorrealbaalexander@gmail.com"
				>
					Contáctame
					<EmailIcon />
				</a>

				<a
					class="flex items-center gap-x-2 border-2 border-purple-700 rounded-full py-2 px-4 font-medium text-sm hover:bg-purple-700 transition-colors duration-300"
					href="https://www.linkedin.com/in/thealexsand/"
					target="_blank"
				>
					LinkedIn
					<LinkedInIcon />
				</a>

				<a
					class="flex items-center gap-x-2 border-2 border-purple-700 rounded-full py-2 px-4 font-medium text-sm hover:bg-purple-700 transition-colors duration-300"
					href="https://github.com/THEALEXSAND"
					target="_blank"
				>
					GitHub
					<GitHubIcon />
				</a>
			</div>
		</div>
		<picture class="max-w-62 mx-8 rounded-full overflow-hidden">
			<img src="img/my-photo.png" alt="Alexander Sandoval" />
		</picture>
	</article>
</section>

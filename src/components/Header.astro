---
const navLinks = [
	{
		label: "skills",
		title: "Habilidades",
		url: "#skills",
	},
	{
		label: "experience",
		title: "Experiencia",
		url: "#experience",
	},
	{
		label: "projects",
		title: "Proyectos",
		url: "#projects",
	},
];
---

<header class="fixed top-0 z-10 w-full flex justify-center items-center mt-2">
	<nav class="header-nav outline-[1.5px] outline-transparent p-2 rounded-full">
		<ul class="flex [&>li>a]:px-4 [&>li>a]:py-1">
			{
				navLinks.map((link) => (
					<li>
						<a
							class="text-sm rounded-full transition-colors duration-300 hover:text-[#d0bcff]"
							href={link.url}
							aria-label={link.label}
						>
							{link.title}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<script>
	const $sections = document.querySelectorAll("section");
	const $navItems = document.querySelectorAll("header nav ul li a");

	const callback = (entries: IntersectionObserverEntry[]) => {
		entries.forEach((entry) => {
			if (entry.isIntersecting) {
				$navItems.forEach((item) => {
					if (item.getAttribute("aria-label") == entry.target.id) {
						item.classList.add(
							"text-[#d0bcff]",
							"bg-primary/15",
							"font-semibold",
						);
						item.classList.remove("text-white");
					} else {
						item.classList.remove(
							"text-[#d0bcff]",
							"bg-primary/15",
							"font-semibold",
						);
						item.classList.add("text-white");
					}
				});
			}
		});
	};

	const observer = new IntersectionObserver(callback, {
		root: null,
		rootMargin: "0px",
		threshold: 0.5,
	});

	$sections.forEach((section) => observer.observe(section));

	document.onvisibilitychange = () => {
		if (document.visibilityState === "hidden") {
			observer.disconnect();
		} else {
			$sections.forEach((section) => {
				observer.observe(section);
			});
		}
	};
</script>

<style>
	.header-nav {
		animation: header-appear 1s linear both;
		animation-timeline: scroll();
		animation-range: 0 100px;
	}

	@keyframes header-appear {
		100% {
			margin-top: 8px;
			backdrop-filter: blur(24px);
			box-shadow: 0px 0px 20px 0px rgba(209, 189, 255, 0.15);
			background-color: #00000080;
			outline-color: color-mix(in oklab, #d0bcff 100%, transparent) !important;
		}
	}
</style>
